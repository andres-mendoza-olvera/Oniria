# Copia este archivo como ".env" y llena tus datos reales.
# En Render, estas mismas variables se ponen en Environment.

DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Correo que envía los mensajes y credenciales de la API de Gmail (Google Cloud)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

BASE_URL=http://localhost:3000

# Cloudflare Workers AI (generación de imágenes)
# Dashboard de Cloudflare -> AI -> Workers AI -> "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase Storage (donde se guardan las imágenes de los sueños)
# URL: Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Llave secreta: Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# o la legacy service_role (eyJ...). NUNCA la pongas en archivos del navegador.
SUPABASE_SERVICE_KEY=
# Nombre del bucket PÚBLICO que creaste en Storage
SUPABASE_BUCKET=suenos

# Clave para firmar la cookie de sesión. Pon un texto largo al azar, genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini (IA de texto: título, historia y prompt de la imagen)
# Llave: https://aistudio.google.com -> Get API key. Si está vacía, los sueños salen solo con imagen.
GEMINI_API_KEY=
# Opcional: modelos a intentar en orden, separados por coma.
# Vacío = gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash
GEMINI_MODEL=
