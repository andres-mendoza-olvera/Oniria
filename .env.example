# Copia este archivo como ".env" y llena tus datos reales.
# En Render, estas mismas variables se ponen en Environment.

DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Correo que envía los mensajes y credenciales de la API de Gmail (Google Cloud)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

BASE_URL=http://localhost:3000

# Cloudflare Workers AI (generación de imágenes)
# Dashboard de Cloudflare -> AI -> Workers AI -> "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase Storage (donde se guardan las imágenes de los sueños)
# URL: Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Llave secreta: Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# o la legacy service_role (eyJ...). NUNCA la pongas en archivos del navegador.
SUPABASE_SERVICE_KEY=
# Nombre del bucket PÚBLICO que creaste en Storage
SUPABASE_BUCKET=suenos

# Clave para firmar la cookie de sesión. Pon un texto largo al azar, genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini (IA de texto: título, historia y prompt de la imagen)
# Llave: https://aistudio.google.com -> Get API key. Si está vacía, los sueños salen solo con imagen.
GEMINI_API_KEY=
# Opcional: modelos a intentar en orden, separados por coma.
# Vacío = gemini-flash-lite-latest,gemini-3.8-flash,gemini-3.5-flash
GEMINI_MODEL=

# httpSMS (codigo de verificacion del telefono por SMS) -> https://httpsms.com
# Los SMS los manda un celular Android con la app de httpSMS abierta y con sesion iniciada.
# API key: https://httpsms.com/settings
HTTPSMS_API_KEY=
# Numero de ese celular en formato internacional, p. ej. +525512345678
HTTPSMS_FROM=

# Modelo propio de Oniria (beta). Si ONIRIA_ACTIVO no es 1, todo sigue con Gemini.
# La API del modelo corre aparte (ver LEEME_INTEGRACION_ONIRIA.md). La clave NUNCA va al navegador.
ONIRIA_ACTIVO=0
# Dirección de la API del modelo, p. ej. http://127.0.0.1:8000 o la URL del túnel
ONIRIA_URL=
# La misma clave que se puso en ONIRIA_API_KEY al arrancar la API del modelo
ONIRIA_API_KEY=
# Tiempo máximo de espera por llamada, en milisegundos. El modelo tarda de 1 a 4 minutos: usa 300000 (5 min)
ONIRIA_TIMEOUT_MS=300000

# Puerto local (Render pone el suyo)
PORT=3000
# HTTPSMS_BASE_URL=https://api.httpsms.com/v1
