# Copia este archivo como ".env" y llena tus datos reales.
# En Render, estas mismas variables se ponen en Environment.

DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Correo que envía los mensajes y credenciales de la API de Gmail (Google Cloud)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

BASE_URL=http://localhost:3000
